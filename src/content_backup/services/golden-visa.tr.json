                        "items":  [
                                      {
                                          "q":  "Birleşik Arap Emirlikleri\u0027nde yaşamıyorsam Altın Vize başvurusunda bulunabilir miyim?",
                                          "a":  "Evet. Altın Vize başvuruları, BAE büyükelçilikleri veya ICA veya GDRFA gibi portallar aracılığıyla dünyanın her yerinden yapılabilir. Ekibimiz size uzaktan destek sağlar."
                                      },
                                      {
                                          "q":  "Gayrimenkul Altın Vizesi için minimum yatırım tutarı nedir?",
                                          "a":  "Birleşik Arap Emirlikleri\u0027nde 2 milyon AED veya daha fazla değere sahip gayrimenkul (proje aşamasında veya hazır). Gayrimenkulün en az 3 yıldır sizin adınıza kayıtlı olması ve sizin mülkiyetinizde bulunması gerekmektedir."
                                      },
                                      {
                                          "q":  "Aile üyelerime sponsor olabilir miyim?",
                                          "a":  "Evet. Altın Vize sahipleri eşlerini, çocuklarını (belirli bir yaşa kadar olan yetişkinler dahil), ebeveynlerini ve ev hizmetlilerini sponsor edebilirler."
                                      },
                                      {
                                          "q":  "Altın Vize ne kadar süreyle geçerlidir?",
                                          "a":  "Uygunluk kategorinize bağlı olarak 5 veya 10 yıl. Yerel bir sponsora gerek kalmadan yenilenebilir."
                                      },
                                      {
                                          "q":  "Yerel bir sponsora ihtiyacım var mı?",
                                          "a":  "Hayır. Altın Vize, yerel bir sponsora duyulan ihtiyacı ortadan kaldırarak size BAE\u0027de iş ve yaşamda tam bağımsızlık sağlar."
                                      },
                                      {
                                          "q":  "Altın Vize belirli bir işverenle bağlantılı mıdır?",
                                          "a":  "Hayır. Herhangi bir işveren veya şirketten tamamen bağımsızdır; özgürce çalışabilir, işletme sahibi olabilir veya serbest meslek sahibi olabilirsiniz."
                                      },
                                      {
                                          "q":  "Serbest çalışanlar Altın Vizeye başvurabilir mi?",
                                          "a":  "Evet, girişimci, yetenek veya uzmanlaşmış profesyonel kategorilerinden birine giriyorsanız."
                                      },
                                      {
                                          "q":  "Vizeyi aldıktan sonra mülkümü satarsam ne olur?",
                                          "a":  "Vizeyi korumak için 2 milyon AED\u0027lik yatırımı sürdürmeniz gerekmektedir. Satış durumunda, mevzuata uygun kalmak için yeniden yatırım yapılması şarttır."
                                      },
                                      {
                                          "q":  "Emirates kimlik kartı ve BAE hizmetlerinden yararlanabilecek miyim?",
                                          "a":  "Evet. Emirates Kimlik Kartı alırsınız ve BAE sağlık hizmetlerine, eğitime, bankacılığa ve tüm konut hizmetlerine erişim sağlarsınız."
                                      }
                                  ]
                    },
