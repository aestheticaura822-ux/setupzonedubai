    "faqs":  [
                 {
                     "q":  "Yaratıcı Şehir Serbest Bölgesi nedir?",
                     "a":  "Fujairah\u0027daki Yaratıcı Şehir Serbest Bölgesi, tasarım, medya, fotoğrafçılık, müzik, içerik oluşturma ve reklamcılık gibi yaratıcı alanlarda çalışan profesyoneller ve işletmeler için özel olarak inşa edilmiş bir serbest bölgedir."
                 },
                 {
                     "q":  "Creative City Fujairah nerede bulunuyor?",
                     "a":  "Creative City Serbest Bölgesi, Birleşik Arap Emirlikleri\u0027nin yedi emirliğinden biri olan Fujairah\u0027da yer almaktadır."
                 },
                 {
                     "q":  "Creative City kurulum paketine neler dahildir?",
                     "a":  "Seçtiğiniz pakete bağlı olarak, Serbest Bölge lisansı, oturma vizesi, sağlık raporu ve Emirates kimliği, kira sözleşmesi, banka hesabı açma yardımı, premium adres ve ücretsiz KDV danışmanlığı alırsınız."
                 },
                 {
                     "q":  "Yaratıcı Şehir paketi ne kadar tutar?",
                     "a":  "Yaratıcı Şehir paketlerimiz 5.999 AED\u0027den (Ekonomi) başlayıp 16.999 AED\u0027ye (Anakara + Konaklama) kadar çıkmaktadır."
                 },
                 {
                     "q":  "Kurulum ne kadar sürer?",
                     "a":  "Ehliyetin verilmesi genellikle 3-7 iş günü sürer ve vize işlemleri ile banka hesabı açılması için ek olarak 1-2 hafta daha gerekir."
                 },
                 {
                     "q":  "Paketimi özelleştirebilir miyim?",
                     "a":  "Evet. Tüm paketler başlangıç noktasıdır ve yaratıcı işinize, vize ihtiyaçlarınıza ve bütçenize uyacak şekilde özelleştirilebilir."
                 },
                 {
                     "q":  "Birleşik Arap Emirlikleri\u0027nde oturum vizesi alabilir miyim?",
                     "a":  "Evet, seçili paketler BAE yatırımcı/ikamet vizesi (sağlık muayenesi dahil), Emirates kimlik kartı ve statü değişikliğini içermektedir."
                 },
                 {
                     "q":  "Banka hesabı açma işlemi fiyata dahil mi?",
                     "a":  "Evet. Tüm paketler, Birleşik Arap Emirlikleri\u0027nin önde gelen bankalarında kurumsal banka hesabı açma konusunda ücretsiz destek içermektedir."
                 },
                 {
                     "q":  "Ne tür yaratıcı aktiviteler yapabilirim?",
                     "a":  "Creative City, tasarım, moda, film yapımı, fotoğrafçılık, müzik, ses, içerik oluşturma, reklamcılık, halkla ilişkiler ve diğer yaratıcı sektörleri desteklemektedir."
                 },
                 {
                     "q":  "Setup Zone Dubai\u0027yi neden tercih etmelisiniz?",
                     "a":  "Şeffaf fiyatlandırma, yaratıcı sektör uzmanlığı, alanında uzman danışmanlar ve uçtan uca destek sunuyoruz; 10.000\u0027den fazla başarılı kurulum gerçekleştirdik."
                 }
