                        "items":  [
                                      {
                                          "q":  "Dubai Silikon Vahası Serbest Bölgesi nedir ve kimler burada yatırım yapmalı?",
                                          "a":  "DSO, teknoloji odaklı işletmeler, girişimler ve ileri üretim için tasarlanmış, devlet destekli bir inovasyon parkı ve serbest bölgedir. Yapay zeka, yazılım, robotik, e-ticaret, fintech ve IoT şirketleri için idealdir."
                                      },
                                      {
                                          "q":  "DSO\u0027da hangi lisanslar mevcuttur?",
                                          "a":  "Ticaret Lisansı (mal alım satımı), Hizmet Lisansı (danışmanlık, yazılım, medya), Sanayi Lisansı (imalat) ve E-ticaret Lisansı (çevrimiçi mağazalar)."
                                      },
                                      {
                                          "q":  "Serbest çalışan bir kişi DSO\u0027da şirket kaydı yaptırabilir mi?",
                                          "a":  "Evet. DSO, serbest çalışanlar için izin belgeleri ve bireysel profesyoneller için uygun fiyatlı paketler sunmaktadır."
                                      },
                                      {
                                          "q":  "Bir DSO şirketinin kurulması için gereken süre ne kadardır?",
                                          "a":  "Belge ve lisans türüne bağlı olarak genellikle 3-5 iş günü sürer."
                                      },
                                      {
                                          "q":  "Hangi belgelere ihtiyacım var?",
                                          "a":  "Pasaport fotokopileri, dijital fotoğraflar, başvuru formu, iş planı (bazı faaliyetler için) ve gerekirse izin belgesi."
                                      },
                                      {
                                          "q":  "DSO şirketim adına vize başvurusunda bulunabilir miyim?",
                                          "a":  "Evet. DSO, ofis türüne ve büyüklüğüne bağlı olarak vize kotaları belirlemektedir: yatırımcı, çalışan ve bakmakla yükümlü olunan kişiler için vizeler."
                                      },
                                      {
                                          "q":  "Ne tür ofisler mevcuttur?",
                                          "a":  "Ortak çalışma alanları, yönetici ofisleri, özel ofisler, inovasyon laboratuvarları, lojistik merkezleri ve veri merkezleri."
                                      },
                                      {
                                          "q":  "Kurulum maliyetleri nelerdir?",
                                          "a":  "Aktiviteye, yapıya ve pakete bağlı olarak yaklaşık 15.500 AED\u0027den başlayan fiyatlarla. Özel fiyat teklifi için bizimle iletişime geçin."
                                      }
                                  ]
