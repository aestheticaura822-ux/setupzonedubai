    "faqsSection":  {
                        "badge":  "Sıkça Sorulan Sorular",
                        "title":  "Sıkça Sorulan Sorular",
                        "titleHighlight":  "Sorular",
                        "subtitle":  "Fujairah Yaratıcı Şehri hakkında bilmeniz gereken her şey. Hala sorularınız mı var? Bir mesaj uzağınızdayız.",
                        "sidebarCard":  {
                                            "title":  "HÃ¢lÃ¢ sorularınız mı var?",
                                            "text":  "FCC uzmanlarımızdan ücretsiz danışmanlık hizmeti alın.",
                                            "whatsappMessage":  "Merhaba! Fujairah Yaratıcı Şehir Serbest Bölgesi hakkında bir sorum var."
                                        },
                        "items":  [
                                      {
                                          "q":  "Birleşik Arap Emirlikleri dışından FCC işletmesi kurmak mümkün mü?",
                                          "a":  "Evet. FCC, yeni kurulan şirketlerin uzaktan çalışmasına izin veriyor. Süreç çoğunlukla çevrimiçi olarak veya vekaletname (POA) yoluyla tamamlanıyor ve bu da siz yokken işlerinizi yürütmenize olanak tanıyor."
                                      },
                                      {
                                          "q":  "FCC lisansımla kaç vize alabilirim?",
                                          "a":  "Vize kontenjanları, lisans paketiniz ve ofis türünüze bağlıdır. Doğru kombinasyonu seçmenize yardımcı oluyoruz."
                                      },
                                      {
                                          "q":  "Bu, serbest çalışanlar için uygun bir seçenek mi?",
                                          "a":  "Kesinlikle. FCC, uygun fiyatlı serbest çalışan lisansları ve ofis gerektirmeyen paketleriyle serbest çalışanlar için en dostane Serbest Bölgelerden biridir."
                                      },
                                      {
                                          "q":  "Lisans almak için ofis kiralamam gerekiyor mu?",
                                          "a":  "Hayır. FCC, ofis gerektirmeyen paketler sunuyor, bu nedenle fiziksel bir alan kiralamadan uzaktan çalışarak yasal olarak faaliyet gösterebilirsiniz."
                                      },
                                      {
                                          "q":  "İşletme faaliyetimi daha sonra güncelleyebilir veya değiştirebilir miyim?",
                                          "a":  "Evet. FCC, faaliyet değişikliklerine ve güncellemelerine izin veriyor. Süreci sizin için biz hallediyoruz."
                                      },
                                      {
                                          "q":  "Kayıt olmak için hangi belgelere ihtiyacım var?",
                                          "a":  "Pasaport fotokopileri, pasaport boyutunda fotoğraflar, önerilen işletme adları ve aktif bir e-posta/iletişim numarası. Her belge konusunda size rehberlik ediyoruz."
                                      },
                                      {
                                          "q":  "Kurulum süreci ne kadar hızlı?",
                                          "a":  "Belgelerin tamamı hazır olduğunda genellikle 3-7 iş günü sürer."
                                      },
                                      {
                                          "q":  "FCC, e-ticaret veya dijital hizmetler için uygun mu?",
                                          "a":  "Evet. FCC, esnek lisanslama ile e-ticaret destek hizmetlerini, dijital pazarlamayı ve teknoloji şirketlerini desteklemektedir."
                                      },
                                      {
                                          "q":  "Bankacılık ve KDV konularında destek alabilir miyim?",
                                          "a":  "Evet. Kurulum sonrası desteğimizin bir parçası olarak banka hesabı açma ve KDV kaydı konusunda yardımcı oluyoruz."
                                      },
                                      {
                                          "q":  "FCC uluslararası alanda tanınıyor mu?",
                                          "a":  "Evet. FCC, BAE hükümeti tarafından desteklenen ve küresel olarak tanınan bir Serbest Bölge\u0027dir."
                                      }
                                  ]
