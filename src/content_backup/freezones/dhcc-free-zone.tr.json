    "faqs":  {
                 "badge":  "Sıkça Sorulan Sorular",
                 "title":  "Sıkça Sorulan Sorular",
                 "titleHighlight":  "Sorular",
                 "subtitle":  "Dubai Sağlık Şehri Serbest Bölgesi hakkında bilmeniz gereken her şey.",
                 "items":  [
                               {
                                   "q":  "Dubai Sağlık Şehri (DHCC) nedir?",
                                   "a":  "DHCC, Dubai\u0027de bulunan ve sağlık ve esenliğe adanmış dünyanın en büyük serbest bölgesidir. Hastaneler, klinikler, eczaneler, laboratuvarlar ve tıp eğitim kurumları da dahil olmak üzere 500\u0027den fazla sağlık ortağına ev sahipliği yapmaktadır."
                               },
                               {
                                   "q":  "DHCC\u0027de kimler iş yeri açabilir?",
                                   "a":  "DHCC\u0027de hekimler, cerrahlar, eczacılar, tanı laboratuvarları, ruh sağlığı uzmanları, diş hekimliği uygulamaları, tıp araştırmacıları, hemşirelik hizmetleri, sağlık teknolojisi şirketleri ve tıp eğitimcileri yerleşebilir."
                               },
                               {
                                   "q":  "DHCC\u0027de hangi lisanslar mevcuttur?",
                                   "a":  "Tıp Lisansı, Eczacılık Lisansı, Tanı ve Laboratuvar Lisansı, Meslek Lisansı, Sağlık Teknolojisi Lisansı ve Eğitim Lisansı."
                               },
                               {
                                   "q":  "DHCC\u0027de faaliyet göstermek için DHA onayına ihtiyacım var mı?",
                                   "a":  "Evet. Sağlık çalışanları ve tesislerinin Dubai Sağlık Otoritesi\u0027nden (DHA) lisans ve düzenleyici onay alması gerekmektedir ve biz bu konuda size yardımcı oluyoruz."
                               },
                               {
                                   "q":  "DHCC\u0027de kayıt işlemi ne kadar sürüyor?",
                                   "a":  "Şirket kurulumu genellikle 3-5 iş günü, faaliyet alanına bağlı olarak DHA sağlık hizmetleri lisansının tamamlanması ise 4-8 hafta sürer."
                               },
                               {
                                   "q":  "DHCC\u0027de %100 yabancı mülkiyeti elde edebilir miyim?",
                                   "a":  "Evet. DHCC, %100 yabancı mülkiyete izin veriyor; yerel sponsor gerekmiyor."
                               },
                               {
                                   "q":  "DHCC\u0027nin vergi avantajları nelerdir?",
                                   "a":  "Kurumlar ve kişisel gelir vergisi %0 olup, kar ve sermayenin tamamı geri gönderilebilir."
                               },
                               {
                                   "q":  "Setup Zone Dubai, DHCC\u0027ye ne tür destekler sağlıyor?",
                                   "a":  "Lisans başvurusu, DHA onayı, ticari isim tescili, belge hazırlama, vize işlemleri, banka hesabı açma ve sürekli uyumluluk konularında hizmet veriyoruz."
                               },
                               {
                                   "q":  "DHCC\u0027de sağlık hizmetleri işletmesi açmak için tıbbi yeterliliğe ihtiyacım var mı?",
                                   "a":  "Evet, klinik faaliyetler için tıp diploması, lisans ve DHA (Disiplin Kuruluna Bağlı Sağlık Otoritesi) üyeliği gereklidir. Klinik dışı faaliyetler için farklı şartlar geçerli olabilir."
                               },
                               {
                                   "q":  "DHCC\u0027de hangi ofis seçenekleri mevcuttur?",
                                   "a":  "İşletme türünüze bağlı olarak esnek çalışma masaları, yönetici ofisleri, klinikler, laboratuvarlar ve özel olarak tasarlanmış tıbbi tesisler."
                               }
                           ]
             },
